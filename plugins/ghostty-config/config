# Ghostty config — Ubuntu (auto-generated by bootstrap.sh)
# See UBUNTU.md in ~/.local/share/terminal-plugins. window-save-state is macOS-only.

# Theme
theme = Ayu

# Tabs
gtk-tabs-location = bottom
window-show-tab-bar = always

# Bell: title prefix while unfocused + taskbar attention (GNOME notification)
bell-features = title,attention

# Progress bars (OSC 9;4) — Claude Code sets terminalProgressBarEnabled
progress-style = true

# Font
font-family = "JetBrains Mono"
font-size = 14

# Window
window-padding-x = 8
window-padding-y = 4
window-decoration = true

# Close the focused split, not the whole tab (override default ctrl+shift+w=close_tab)
keybind = ctrl+shift+w=close_surface

# Tab bar font size (GTK custom CSS — no native config option for this)
gtk-custom-css = ~/.config/ghostty/ghostty-custom.css
