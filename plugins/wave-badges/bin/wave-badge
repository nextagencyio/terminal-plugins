#!/bin/bash
# Wave Terminal status badges for terminal AI agents (Claude Code, Devin CLI, opencode).
# Usage: wave-badge <agent-name> <start|working|attention|question|done|error|clear>
# Reads the hook's JSON payload on stdin (cwd, tool_name, message) to add context
# to titles and notifications. No-op outside Wave.

INPUT=""
[ -t 0 ] || INPUT=$(head -c 8192)

[ -n "$WAVETERM_BLOCKID" ] || exit 0

# wsh is normally on PATH inside a Wave block. When it isn't, fall back to the
# copy bundled with the app — the binaries are named wsh-<version>-<os>.<arch>,
# so resolve the current platform rather than assuming Apple Silicon.
WSH=$(command -v wsh 2>/dev/null)
if [ -z "$WSH" ]; then
    case "$(uname -s)" in
        Darwin) WSH_OS=darwin ;;
        Linux)  WSH_OS=linux ;;
        *)      WSH_OS="" ;;
    esac
    case "$(uname -m)" in
        arm64|aarch64) WSH_ARCH=arm64 ;;
        x86_64|amd64)  WSH_ARCH=x64 ;;
        *)             WSH_ARCH="" ;;
    esac
    if [ -n "$WSH_OS" ] && [ -n "$WSH_ARCH" ]; then
        WSH=$(ls -t \
            "$HOME"/.waveterm/bin/wsh \
            "$HOME"/Applications/Wave.app/Contents/Resources/app.asar.unpacked/dist/bin/wsh-*-"$WSH_OS"."$WSH_ARCH" \
            /Applications/Wave.app/Contents/Resources/app.asar.unpacked/dist/bin/wsh-*-"$WSH_OS"."$WSH_ARCH" \
            /opt/Wave/resources/app.asar.unpacked/dist/bin/wsh-*-"$WSH_OS"."$WSH_ARCH" \
            "$HOME"/Applications/wave-terminal/resources/app.asar.unpacked/dist/bin/wsh-*-"$WSH_OS"."$WSH_ARCH" \
            2>/dev/null | head -1)
    fi
fi
[ -x "$WSH" ] || exit 0

AGENT="${1:-Agent}"
STATE="$2"

CWD="" MSG="" TOOL=""
if command -v jq >/dev/null 2>&1 && [ -n "$INPUT" ]; then
    CWD=$(jq -r '.cwd // empty' <<<"$INPUT" 2>/dev/null)
    MSG=$(jq -r '.message // empty' <<<"$INPUT" 2>/dev/null)
    TOOL=$(jq -r '.tool_name // empty' <<<"$INPUT" 2>/dev/null)
fi
[ -n "$CWD" ] || CWD="${DEVIN_PROJECT_DIR:-$PWD}"
PROJECT=$(basename "$CWD" 2>/dev/null)
CTX=""
[ -n "$PROJECT" ] && CTX=" · $PROJECT"

# Walk up the process tree to the agent process. Badges pid-linked to it
# survive Wave's clear-on-focus and auto-clear when the session exits.
agent_pid() {
    local pid=$PPID comm
    while [ -n "$pid" ] && [ "$pid" -gt 1 ]; do
        comm=$(ps -o comm= -p "$pid" 2>/dev/null)
        case "${comm##*/}" in
            devin|claude|node|bun|opencode) echo "$pid"; return ;;
        esac
        pid=$(ps -o ppid= -p "$pid" 2>/dev/null | tr -d ' ')
    done
}

PID=$(agent_pid)
PIDFLAG=()
[ -n "$PID" ] && PIDFLAG=(--pid "$PID")

set_title() {
    local label="$PROJECT" branch
    branch=$(git -C "$CWD" rev-parse --abbrev-ref HEAD 2>/dev/null)
    [ -n "$branch" ] && [ "$branch" != "HEAD" ] && label="$label · $branch"
    [ -n "$label" ] && "$WSH" setmeta "frame:title=$AGENT — $label"
}

# Wave only lets a new badge replace a higher-priority one, so every
# transition clears first — otherwise a bell (20) could never step down
# to a spinner (5) or check (10).  A short sleep after each clear is
# critical: wsh badge --clear and the following wsh badge set are
# separate RPC calls whose frontend events can arrive out of order
# (clear after set), silently wiping the new badge.  0.15s is enough
# for the clear event to be processed without noticeably delaying the
# state transition.
case "$STATE" in
    start)
        "$WSH" badge --clear
        set_title
        ;;
    working)
        "$WSH" badge --clear; sleep 0.15
        "$WSH" badge spinner-third+spin --color '#00FFDB' --priority 5 "${PIDFLAG[@]}"
        ;;
    attention)
        "$WSH" badge --clear; sleep 0.15
        "$WSH" badge bell --color yellow --priority 20 --beep "${PIDFLAG[@]}"
        "$WSH" notify "${MSG:-needs your input}${TOOL:+ [$TOOL]}$CTX" -t "$AGENT"
        ;;
    question)
        "$WSH" badge --clear; sleep 0.15
        "$WSH" badge message-question --color '#e0b956' --priority 20 --beep "${PIDFLAG[@]}"
        "$WSH" notify "${MSG:-has a question for you}$CTX" -t "$AGENT"
        ;;
    done)
        "$WSH" badge --clear; sleep 0.15
        "$WSH" badge check --color green --priority 10 "${PIDFLAG[@]}"
        "$WSH" notify "finished its turn$CTX" -t "$AGENT"
        ;;
    error)
        "$WSH" badge --clear; sleep 0.15
        "$WSH" badge triangle-exclamation --color '#FF453A' --priority 15 "${PIDFLAG[@]}"
        "$WSH" notify "${MSG:-hit an error}$CTX" -t "$AGENT"
        ;;
    clear)
        "$WSH" badge --clear
        ;;
esac 2>/dev/null

exit 0
